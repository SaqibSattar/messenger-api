NODE_ENV=development
PORT=3000
# Comma-separated allowlist. Never use `*` in production — the config
# validator rejects wildcards when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
BODY_LIMIT=100kb
# Hard cap on per-request lifetime (ms). 0 disables.
REQUEST_TIMEOUT_MS=15000
# Number of trusted proxy hops in front of the API (ALB, nginx, ...).
# Leave at 0 for single-host development.
TRUST_PROXY=0

MONGODB_URI=mongodb://localhost:27017/messenger
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-me-in-production
JWT_REFRESH_SECRET=replace-me-in-production
JWT_ISSUER=messenger-api
JWT_AUDIENCE=messenger-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Realtime / Socket.IO
SOCKET_PATH=/socket.io
SOCKET_TYPING_MAX_PER_MINUTE=60
PRESENCE_TTL_SECONDS=90

# Media / Attachments
# memory: synthetic signed URLs, for dev/test only. s3: requires bucket/region/keys below.
STORAGE_PROVIDER=memory
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=https://storage.example.local
STORAGE_SIGNING_SECRET=replace-me-storage-signing-secret
MEDIA_MAX_BYTES=26214400
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_DOWNLOAD_URL_TTL_SECONDS=300
MEDIA_PENDING_TTL_SECONDS=3600
MEDIA_MAX_ATTACHMENTS_PER_MESSAGE=10

# Stories / Status
# Story details reuse MEDIA_DOWNLOAD_URL_TTL_SECONDS for signed media URLs.
# Lifetime, audience-list size, and per-user active-story caps are compile-
# time constants in src/modules/stories/story.types.ts.

# Search & Notifications
# Search query bounds, pagination caps, and notification preview limits are
# compile-time constants in src/modules/search/search.types.ts and
# src/modules/notifications/notification.types.ts. The push-notification
# worker is a placeholder (jobs/pushNotificationJob.ts) that emits structured
# logs; APNs/FCM credentials are not required yet — the integration point
# is wired so swapping in a real transport is a single-file change.

# Admin / Audit / Observability
# Audit log retention, page sizes, and metadata sanitisation rules are
# compile-time constants in src/modules/admin/auditLog.{types,service}.ts.
# Admin endpoints:
#   GET  /api/v1/admin/audit-logs       — requires admin:audit:read
#   GET  /api/v1/admin/system-summary   — requires admin:system:read
#   GET  /metrics                       — requires admin:system:read

# Data layer / Migrations
# Run `npm run migrate` to apply every pending migration against MONGODB_URI.
# The runner records applied migrations in the `migrationrecords` collection
# and is safe to invoke on every deploy — already-applied migrations are
# skipped via a unique index on (name).
# Run `npm run seed:dev` to populate a small fixture set (users, a direct
# conversation, a small group) for local hacking. Refuses to run when
# NODE_ENV=production. Override the >20-users safety check with SEED_FORCE=1.

# Contacts / Invites / Privacy
# Contact request and invite-link size/lifetime caps live in
# src/modules/contacts/contact.types.ts and src/modules/invites/invite.types.ts
# as compile-time constants (token length, default TTL, max active invites
# per conversation, etc.). The audience values for privacy-scoped settings
# (`everyone`, `contacts`, `nobody`) live in src/modules/users/user.types.ts.
# Endpoints:
#   POST   /api/v1/contacts/requests                — send a contact request
#   GET    /api/v1/contacts/requests/{incoming,outgoing}
#   POST   /api/v1/contacts/requests/:requestId/accept
#   POST   /api/v1/contacts/requests/:requestId/decline
#   DELETE /api/v1/contacts/requests/:requestId    — cancel sent request
#   GET    /api/v1/contacts                        — list confirmed contacts
#   DELETE /api/v1/contacts/:userId                — remove contact (both rows)
#   POST   /api/v1/conversations/:id/invites       — create group invite link
#   GET    /api/v1/conversations/:id/invites       — list invites (admins)
#   POST   /api/v1/invites/:token/join             — redeem invite token
#   DELETE /api/v1/invites/:inviteId               — revoke invite
#   GET    /api/v1/privacy-settings                — fetch caller settings
#   PATCH  /api/v1/privacy-settings                — patch caller settings

# Privacy / retention / account deletion
# Grace-window length, retention horizons for sessions/notifications/invites,
# and cleanup-job batch sizes are compile-time constants in
# src/modules/privacy/privacy.types.ts (ACCOUNT_DELETION_GRACE_DAYS,
# NOTIFICATION_RETENTION_DAYS, REVOKED_SESSION_RETENTION_DAYS,
# INVITE_RETENTION_DAYS, CLEANUP_BATCH_SIZE). See docs/PRIVACY_RETENTION.md
# for what finalization deletes vs preserves and the full lifecycle state
# machine.
# Endpoints (all bearer-auth):
#   POST   /api/v1/users/me/delete-request          — schedule deletion
#   POST   /api/v1/users/me/delete-cancel           — cancel deletion
#   GET    /api/v1/users/me/data-export             — export caller's data
# Background workers (started by the host process, not the API):
#   finalizeAccountDeletions  — turns elapsed delete-requests into DELETED
#                               accounts; anonymizes the user document and
#                               cascades cleanup across ~10 collections
#   cleanupSessions           — hard-deletes long-revoked sessions
#   cleanupNotifications      — drops notifications older than retention
#   cleanupInvites            — drops revoked/expired invite links
