NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
BODY_LIMIT=100kb

MONGODB_URI=mongodb://localhost:27017/messenger
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-me-in-production
JWT_REFRESH_SECRET=replace-me-in-production
JWT_ISSUER=messenger-api
JWT_AUDIENCE=messenger-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Realtime / Socket.IO
SOCKET_PATH=/socket.io
SOCKET_TYPING_MAX_PER_MINUTE=60
PRESENCE_TTL_SECONDS=90
