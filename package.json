    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.13",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.8.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.2",
